  <div class="stat"><span class="muted">Variation</span><strong class="${d<=0?'pos':'neg'}">${d>0?"+":""}${fmt(d)}</strong><span class="small">kg au total</span></div>
  <div class="stat"><span class="muted">${ref?"4 dernières sem.":"Plus bas"}</span><strong>${ref?(ws.at(-1).value-ref.value>0?"+":"")+fmt(ws.at(-1).value-ref.value):fmt(min)}</strong><span class="small">kg</span></div>`}
 const waist=ws.filter(w=>num(w.waist)>0);
 if(waist.length){$("#waistCard").classList.remove("hidden");lineChart($("#waistChart"),waist.map(w=>({t:ts(w.date),y:num(w.waist),date:w.date})),{unit:"cm"})}
 $("#wList").innerHTML=ws.slice(-10).reverse().map(w=>`<div class="list-row"><span>${fdl(w.date)}</span><span><b>${fmt(w.value)} kg</b>${w.waist?` · ${fmt(num(w.waist))} cm`:""} <button class="ghost" onclick="delWeight(${data.weights.indexOf(w)})" aria-label="Supprimer">✕</button></span></div>`).join("")||'<div class="empty">Aucun poids enregistré.</div>';
}
function saveWeight(){
 const v=$("#weight").value;if(!v){toast("Saisis ton poids.");return}
 const date=$("#weightDate").value||today(),waist=$("#waist").value;
 const ex=data.weights.find(w=>w.date===date);
 if(ex){ex.value=num(v);if(waist)ex.waist=num(waist)}else data.weights.push({date,value:num(v),...(waist?{waist:num(waist)}:{})});
 persist();toast(ex?"Mesure du jour mise à jour":"✅ Poids enregistré");renderCorps()}
function delWeight(i){if(i<0||!confirm("Supprimer cette mesure ?"))return;data.weights.splice(i,1);persist();renderCorps()}

/* ---------- Vue Historique ---------- */
function renderHisto(){
 const ss=sorted().reverse(),cs=[...data.cardio].sort((a,b)=>b.date.localeCompare(a.date));
 $("#view").innerHTML=`
 <section class="card"><h2>Séances</h2><div id="sList"></div></section>
 ${cs.length?`<section class="card"><h2>Cardio seul</h2>${cs.slice(0,15).map(c=>`<div class="list-row"><span>${fdl(c.date)} · ${esc(c.type||"Cardio")}</span><span>${esc(c.duration)} min${c.distance?` · ${esc(c.distance)} km`:""} <button class="ghost" onclick="delCardio(${c.id})">✕</button></span></div>`).join("")}</section>`:""}
 <section class="card"><h2>Sauvegarde</h2>
  <div class="actions"><button class="secondary" onclick="exportData()">Exporter (JSON)</button><button class="secondary" onclick="exportCSV()">Exporter (CSV / Excel)</button><button class="secondary" onclick="$('#importFile').click()">Importer une sauvegarde</button></div>
  <p class="small">Les données restent dans le stockage du navigateur sur cet appareil. ${lastBackup()} Exporte régulièrement une sauvegarde (Fichiers / iCloud) pour éviter toute perte.</p></section>`;
 const show=ss.slice(0,ui.histMore?500:15);
 $("#sList").innerHTML=show.map(s=>{
  const by={};s.sets.forEach(x=>(by[x.exercise]=by[x.exercise]||[]).push(x));
  const vol=s.sets.reduce((a,x)=>a+num(x.kg)*num(x.reps),0);
  return `<details><summary><span><b>${esc(shortName(s))}</b><br><span class="small">${fdl(s.date)}</span></span><span class="small" style="text-align:right">${s.total} séries<br>${fmt(vol,0)} kg${s.cardio&&num(s.cardio.duration)?` · ${esc(s.cardio.duration)} min cardio`:""}</span></summary>
  <div style="margin-top:8px">${Object.entries(by).map(([n,xs])=>`<div class="list-row"><span>${esc(n)}</span><span class="small">${xs.map(x=>x.kg?`${esc(x.kg)}×${esc(x.reps||"—")}`:`${esc(x.reps)} reps`).join(" · ")}</span></div>`).join("")}
  ${s.cardio&&num(s.cardio.duration)?`<div class="small" style="margin-top:6px">Cardio : ${esc(s.cardio.type||"—")} · ${esc(s.cardio.duration)} min${s.cardio.distance?` · ${esc(s.cardio.distance)} km`:""}${s.cardio.calories?` · ${esc(s.cardio.calories)} kcal`:""}</div>`:""}
  ${s.notes?`<div class="small" style="margin-top:6px">📝 ${esc(s.notes)}</div>`:""}
  <div class="actions"><button class="tiny secondary" onclick="delSession(${s.id})">Supprimer la séance</button></div></div></details>`}).join("")||'<div class="empty">Aucune séance enregistrée.</div>';
 if(ss.length>15&&!ui.histMore)$("#sList").insertAdjacentHTML("beforeend",`<div class="actions"><button class="tiny secondary" onclick="ui.histMore=true;renderHisto()">Voir tout (${ss.length})</button></div>`);
}
function delSession(id){if(!confirm("Supprimer définitivement cette séance ?"))return;data.sessions=data.sessions.filter(s=>s.id!==id);persist();renderHisto()}
function delCardio(id){if(!confirm("Supprimer ce cardio ?"))return;data.cardio=data.cardio.filter(c=>c.id!==id);persist();renderHisto()}
function lastBackup(){const b=data.settings.lastExport;return b?`Dernière sauvegarde : ${fdl(b)}.`:"Aucune sauvegarde exportée pour l'instant."}

/* ---------- Export / import ---------- */
function download(content,name,type){const blob=new Blob([content],{type}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function exportData(){data.settings.lastExport=today();persist();download(JSON.stringify(data,null,2),`my-gym-progress-sauvegarde-${today()}.json`,"application/json");renderHisto()}
function exportCSV(){
 const q=v=>`"${String(v??"").replace(/"/g,'""')}"`,rows=[["Date","Séance","Exercice","Série","Charge (kg)","Répétitions","Volume"]];
 sorted().forEach(s=>s.sets.forEach(x=>rows.push([s.date,s.name,x.exercise,x.set,String(x.kg).replace(".",","),x.reps,String(num(x.kg)*num(x.reps)).replace(".",",")])));
 download("\ufeff"+rows.map(r=>r.map(q).join(";")).join("\n"),`my-gym-progress-${today()}.csv`,"text/csv")}
function importData(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d||!Array.isArray(d.sessions))throw 0;
 if(!confirm(`Remplacer les données actuelles par cette sauvegarde (${d.sessions.length} séances) ?`))return;data=normalize(d);persist();toast("Sauvegarde importée");renderView()}catch{toast("Fichier de sauvegarde invalide.")}finally{e.target.value=""}};r.readAsText(f)}

/* ---------- Démarrage ---------- */
// Si le cardio autonome était utilisé dans une ancienne version, on s'assure que tout est cohérent
updateStats();renderView();
let rz;window.addEventListener("resize",()=>{clearTimeout(rz);rz=setTimeout(()=>{if(ui.view==="evo")renderEvo();if(ui.view==="corps")renderCorps()},200)});
</script></body></html>
