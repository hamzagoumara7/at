  <div class="grid3"><div class="stat"><span class="muted">30 derniers j.</span><strong>${last30}</strong><span class="small">séances</span></div>
  <div class="stat"><span class="muted">Tonnage sem.</span><strong>${tW>=1000?fmt(tW/1000)+" t":fmt(tW,0)+" kg"}</strong><span class="small">${tP?`<span class="${tW>=tP?'pos':'neg'}">${tW>=tP?"+":""}${fmt((tW-tP)/tP*100,0)} %</span> vs S-1`:"&nbsp;"}</span></div>
  <div class="stat"><span class="muted">Records</span><strong>${countPRs()}</strong><span class="small">exercices suivis</span></div></div>
  <h3>Par semaine</h3>
  <div class="seg" id="wkSeg">${[["tonnage","Tonnage"],["count","Séances"],["cardio","Cardio"]].map(([k,l])=>`<button class="${ui.week===k?'on':''}" onclick="ui.week='${k}';saveUI();renderEvo()">${l}</button>`).join("")}</div>
  <div id="wkChart"></div>
  <div class="small" style="margin-top:6px">${{tonnage:"Tonnage = somme charge × répétitions de toutes les séries.",count:"Nombre de séances de musculation enregistrées par semaine.",cardio:"Minutes de cardio (après séance + cardio seul)."}[ui.week]}</div>
 </section>
 <section class="card"><h2>Progression par exercice</h2>
  <select onchange="ui.exercise=this.value;saveUI();renderEvo()">${opts}</select>
  <div id="exStats" class="grid3" style="margin-top:10px"></div>
  <div class="seg" id="mSeg"></div>
  <div id="exChart"></div>
  <div class="small" id="exNote" style="margin-top:6px"></div>
 </section>
 <section class="card"><h2>Mes records</h2><div id="prTable"></div></section>`;
 // graphique hebdo
 const cardio=allCardio();
 const bars=wk.map(d=>({date:d,y:ui.week==="tonnage"?tonnage(d):ui.week==="count"?data.sessions.filter(s=>s.date&&mondayOf(s.date)===d).length:cardio.filter(c=>c.date&&mondayOf(c.date)===d).reduce((a,c)=>a+num(c.duration),0)}));
 barChart($("#wkChart"),bars,{unit:{tonnage:"kg",count:"séance(s)",cardio:"min"}[ui.week]});
 // exercice
 const h=exerciseHistory(ui.exercise),hasKg=h.some(x=>x.maxKg>0);
 const metrics=hasKg?[["e1rm","1RM estimé"],["max","Charge max"],["vol","Volume"]]:[["reps","Reps max"],["tot","Reps totales"]];
 if(!metrics.some(m=>m[0]===ui.metric))ui.metric=metrics[0][0];
 $("#mSeg").innerHTML=metrics.map(([k,l])=>`<button class="${ui.metric===k?'on':''}" onclick="ui.metric='${k}';saveUI();renderEvo()">${l}</button>`).join("");
 const val=x=>({e1rm:x.best,max:x.maxKg,vol:x.volume,reps:x.maxReps,tot:x.sets.reduce((a,s)=>a+s.reps,0)}[ui.metric]);
 const pts=h.map(x=>({t:ts(x.date),y:val(x),date:x.date,note:x.sets.map(s=>s.kg?`${fmt(s.kg,2)}×${s.reps}`:`${s.reps}`).join(" ")}));
 lineChart($("#exChart"),pts,{unit:ui.metric==="reps"||ui.metric==="tot"?"reps":"kg",dec:ui.metric==="vol"?0:1});
 if(h.length){
