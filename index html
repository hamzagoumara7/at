  $("#exNote").textContent=ui.metric==="e1rm"?"1RM estimé (formule d'Epley) : compare des séries faites à des charges et répétitions différentes. Indicatif, pas un test de force max.":ui.metric==="vol"?"Volume = somme charge × répétitions sur l'exercice pour la séance.":"";
 } else {$("#exStats").innerHTML="";$("#exNote").textContent=""}
 // records
 const rows=[...names,...extra].map(n=>{const hh=exerciseHistory(n);if(!hh.length)return"";const mk=Math.max(...hh.map(x=>x.maxKg)),b1=Math.max(...hh.map(x=>x.best)),mr=Math.max(...hh.map(x=>x.maxReps));const d=hh.find(x=>x.maxKg===mk).date;
  return `<tr onclick="ui.exercise='${esc(n).replace(/'/g,"\\'")}';saveUI();renderEvo();window.scrollTo({top:document.querySelectorAll('.card')[1].offsetTop-10,behavior:'smooth'})"><td>${esc(n)}</td><td class="r"><b>${mk?fmt(mk,2)+" kg":mr+" reps"}</b></td><td class="r">${b1?fmt(b1):"—"}</td><td class="r small">${fd(d)}</td></tr>`}).join("");
 $("#prTable").innerHTML=rows?`<table><tr><th>Exercice</th><th class="r">Max</th><th class="r">1RM est.</th><th class="r">Date</th></tr>${rows}</table>`:'<div class="empty">Enregistre ta première séance pour voir tes records.</div>';
}
function countPRs(){return new Set(data.sessions.flatMap(s=>s.sets.filter(x=>num(x.kg)||num(x.reps)).map(x=>x.exercise))).size}

