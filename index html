function allCardio(){return [...data.sessions.filter(s=>s.cardio&&num(s.cardio.duration)>0).map(s=>({date:s.date,...s.cardio,from:s.name})),...data.cardio.map(c=>({...c,from:"Cardio seul"}))]}
function weeks(n=12){const out=[];const d=new Date(mondayOf(today())+"T12:00:00");for(let i=n-1;i>=0;i--){const x=new Date(d);x.setDate(d.getDate()-7*i);out.push(x.toISOString().slice(0,10))}return out}
function renderEvo(){
 const names=[];workouts.forEach(w=>w.items.forEach(it=>names.includes(it[0])||names.push(it[0])));
 const extra=[...new Set(data.sessions.flatMap(s=>s.sets.map(x=>x.exercise)))].filter(n=>!names.includes(n));
 const withData=new Set(data.sessions.flatMap(s=>s.sets.map(x=>x.exercise)));
 if(!ui.exercise||!(names.includes(ui.exercise)||extra.includes(ui.exercise)))ui.exercise=[...names,...extra].find(n=>withData.has(n))||names[0];
 const opts=workouts.filter(w=>w.items.length).map(w=>`<optgroup label="${esc(w.name)}">${w.items.map(it=>`<option ${it[0]===ui.exercise?'selected':''}>${esc(it[0])}</option>`).join("")}</optgroup>`).join("")+(extra.length?`<optgroup label="Autres">${extra.map(n=>`<option ${n===ui.exercise?'selected':''}>${esc(n)}</option>`).join("")}</optgroup>`:"");
 // semaine
 const wk=weeks(12),cur=mondayOf(today());
 const tonnage=d=>data.sessions.filter(s=>s.date&&mondayOf(s.date)===d).reduce((a,s)=>a+s.sets.reduce((b,x)=>b+num(x.kg)*num(x.reps),0),0);
 const tW=tonnage(cur),tP=tonnage(wk.at(-2));
